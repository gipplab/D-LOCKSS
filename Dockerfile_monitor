FROM golang:1.25-alpine AS builder

ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -ldflags="-s -w" -o dlockss-monitor ./cmd/dlockss-monitor

FROM alpine:3.21 AS final

COPY --from=builder /build/dlockss-monitor /usr/local/bin/dlockss-monitor

# Return freed memory to OS; cap heap; trigger GC earlier
ENV GODEBUG=madvdontneed=1 \
    GOMEMLIMIT=512MiB \
    GOGC=50

EXPOSE 8080

CMD ["dlockss-monitor"]
